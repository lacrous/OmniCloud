{
  "name": "@omnicloud/crypto",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src test scripts",
    "verify:vectors": "tsx scripts/verify-vectors-node.ts",
    "verify:vectors:cross-client": "tsx scripts/verify-cross-client.mjs",
    "vectors:write": "tsx scripts/write-vectors.ts"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
