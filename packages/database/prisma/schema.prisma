// OmniCloud metadata schema (v0.2).
//
// Telegram stores the actual binary file content; PostgreSQL stores the
// logical representation of the user's cloud (users, folders, file metadata,
// versions, trash state, stars, activity events, storage registrations and
// Telegram sessions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  telegramUserId BigInt   @unique
  username       String?
  firstName      String?
  lastName       String?
  phone          String?
  /// Opaque OCE1 recovery blob (server cannot open it without the user's code).
  recoveryBlob   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  telegramSession  TelegramSession?
  storages         Storage[]
  folders          Folder[]
  files            File[]
  fileVersions     FileVersion[]
  activityEvents   ActivityEvent[]
  browserSessions  BrowserSession[]
  apiTokens        ApiToken[]
  uploadOperations UploadOperation[]
}

/// A signed-in browser session. Only the SHA-256 of the cookie token is stored,
/// so revoking the row ends the session on the next request.
model BrowserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  ip         String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// One logical upload, keyed by a client-supplied id so a retry never stores a
/// second Telegram object. `telegramMessageId` is recorded as soon as Telegram
/// accepts the object, so recovery can commit the file without uploading again.
model UploadOperation {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationId        String
  status             String
  telegramMessageId  BigInt?
  sha256             String?
  size               BigInt?
  requestFingerprint String?
  fileId             String?
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, operationId])
  @@index([status, updatedAt])
}

/// Personal API token for scripts and the SDK. Only a SHA-256 hash of the secret
/// is stored; the secret itself is shown once, when the token is created.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([userId, revokedAt])
}

/// MTProto session string for the user's connected Telegram account.
/// Never exposed through the API and never logged.
model TelegramSession {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stringSession String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// The user's private storage channel used as the backing object store.
model Storage {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String   @default("telegram")
  title              String
  telegramChatId     BigInt
  telegramAccessHash BigInt
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, provider])
}

/// Folders are virtual OmniCloud objects — they have no physical
/// representation on Telegram. `deletedAt` is the Trash marker.
model Folder {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Folder[]  @relation("FolderTree")
  name         String
  starred      Boolean   @default(false)
  deletedAt    DateTime?
  /// Groups everything one trash operation moved, for exact restore.
  trashBatchId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  files        File[]

  @@index([userId, parentId, deletedAt])
  /// Leading parentId index: enforces the self-relation and serves child lookups
  /// that do not filter by userId (recursive delete).
  @@index([parentId])
  @@index([userId, deletedAt])
  @@index([userId, name])
  @@index([userId, starred])
}

/// File metadata. `telegramMessageId` points at the current version's message
/// in the user's storage channel; `currentVersionId` links the version row
/// that content is served from.
model File {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId          String?
  folder            Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name              String
  size              BigInt
  mimeType          String
  sha256            String
  telegramMessageId BigInt
  /// Opaque E2EE metadata (OCE1) for the current version; null = plaintext.
  /// The server never interprets these fields.
  encryptionFormat  String?
  wrappedKey        String?
  metadataBlob      String?
  keyEpoch          Int?
  starred           Boolean   @default(false)
  deletedAt         DateTime?
  /// Groups everything one trash operation moved, for exact restore.
  trashBatchId      String?
  /// The version this file currently points at. Null until versioning is
  /// initialised, and null if that version is gone.
  currentVersionId  String?     @unique
  currentVersion    FileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  versionCount      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  versions FileVersion[]

  @@index([userId, folderId, deletedAt])
  /// Leading folderId index: enforces the relation and serves folder-scoped deletes.
  @@index([folderId])
  @@index([userId, deletedAt])
  @@index([userId, name])
  @@index([userId, starred])
  @@index([userId, size])
  @@index([userId, mimeType])
}

/// Version foundation for v0.3's version history. Every upload creates a row;
/// replacing a file appends a version and repoints the file's current version.
model FileVersion {
  id                String   @id @default(cuid())
  fileId            String
  file              File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionNumber     Int
  size              BigInt
  mimeType          String
  sha256            String
  telegramMessageId BigInt
  /// Opaque E2EE metadata (OCE1) for this version; null = plaintext.
  /// The server never interprets these fields.
  encryptionFormat  String?
  wrappedKey        String?
  metadataBlob      String?
  keyEpoch          Int?
  createdAt         DateTime @default(now())

  /// The file, if this is the version it currently points at.
  currentFor        File?     @relation("CurrentVersion")

  @@unique([fileId, versionNumber])
  @@index([fileId])
  @@index([userId])
}

/// Structured activity/audit events. Metadata never contains credentials.
model ActivityEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  resourceType String
  resourceId   String
  resourceName String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, resourceId, createdAt])
  @@index([createdAt])
}
