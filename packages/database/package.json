{
  "name": "@omnicloud/database",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@omnicloud/core": "workspace:*",
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0",
    "tsx": "^4.19.2"
  }
}
