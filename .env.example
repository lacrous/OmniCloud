# OmniCloud configuration
# Copy this file to .env and fill in real values. Never commit .env to Git.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# For the bundled docker-compose.yml, the password comes from POSTGRES_PASSWORD.
# Set it before anything other than a local development machine.
DATABASE_URL=postgresql://omnicloud:omnicloud-dev-only@127.0.0.1:5432/omnicloud

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED in production. Seals Telegram session strings at rest (AES-256-GCM).
# Generate with `openssl rand -hex 32`. Keep it backed up apart from the
# database: losing it makes stored Telegram sessions unreadable.
OMNICLOUD_ENCRYPTION_KEY=

# Reserved. Browser sessions are server-side tokens and do not use this value.
SESSION_SECRET=

# Set to true when serving OmniCloud over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false

# Comma-separated list of origins allowed to make state-changing requests.
# Leave empty for same-origin only (the default).
ALLOWED_ORIGINS=

# Trust X-Forwarded-* headers from a reverse proxy (needed for correct client
# IPs behind a load balancer). Only enable when a proxy really is in front.
TRUST_PROXY=false

# ── Telegram (required) ─────────────────────────────────────────────────────
# Create an application at https://my.telegram.org → "API development tools"
# to obtain an api_id and api_hash for your deployment.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Server ──────────────────────────────────────────────────────────────────
# Interface and port the API listens on.
HOST=0.0.0.0
PORT=4000

# The `omnicloud` command defaults to "production"; running the API directly
# defaults to "development". Production requires OMNICLOUD_ENCRYPTION_KEY.
NODE_ENV=production
LOG_LEVEL=info

# Maximum accepted upload size in megabytes. Uploads are spooled to a temporary
# directory on disk, not held in memory.
MAX_UPLOAD_MB=256

# Directory containing the built web application (optional).
# When present, the API serves the web UI from a single port.
WEB_DIST_DIR=

# ── Storage ─────────────────────────────────────────────────────────────────
# Optional storage quota in gigabytes, shown on the Storage dashboard.
# Leave empty or 0 for "no quota" (the default).
STORAGE_QUOTA_GB=0

# ── Web build ───────────────────────────────────────────────────────────────
# Canonical origin used in the built web app: canonical link, Open Graph and
# Twitter tags, JSON-LD, robots.txt and sitemap.xml.
# Leave empty to use the default Vercel deployment URL.
# Vite inlines this at build time — changing it requires a rebuild.
VITE_SITE_URL=

# ── Update check ────────────────────────────────────────────────────────────
# npm package checked for newer releases. The server polls the registry once
# an hour and shows a notice in the web sidebar when a newer version exists.
# Set UPDATE_CHECK_ENABLED=false to disable the check entirely.
UPDATE_PACKAGE_NAME=@hilbras/omnicloud
UPDATE_CHECK_ENABLED=true

# ── Trash retention ──────────────────────────────────────────────────────────
# Days a trashed file or folder is kept before it is permanently removed.
# The server purges expired trash every six hours. Set to 0 to keep everything
# in the trash indefinitely.
TRASH_RETENTION_DAYS=30
