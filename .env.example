# OmniCloud configuration
# Copy this file to .env and fill in real values. Never commit .env to Git.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://omnicloud:omnicloud@localhost:5432/omnicloud

# ── Security ────────────────────────────────────────────────────────────────
# Secret used to sign browser session tokens (JWT). Use a long random string,
# e.g. `openssl rand -hex 32`. Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when serving OmniCloud over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false

# Comma-separated list of origins allowed to make state-changing requests.
# Leave empty for same-origin only (the default).
ALLOWED_ORIGINS=

# Trust X-Forwarded-* headers from a reverse proxy (needed for correct client
# IPs behind a load balancer). Only enable when a proxy really is in front.
TRUST_PROXY=false

# ── Telegram (required) ─────────────────────────────────────────────────────
# Create an application at https://my.telegram.org → "API development tools"
# to obtain an api_id and api_hash for your deployment.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Server ──────────────────────────────────────────────────────────────────
# Interface and port the API listens on.
HOST=0.0.0.0
PORT=4000

NODE_ENV=development
LOG_LEVEL=info

# Maximum accepted upload size in megabytes (files are buffered in memory).
MAX_UPLOAD_MB=256

# Directory containing the built web application (optional).
# When present, the API serves the web UI from a single port.
WEB_DIST_DIR=

# ── Storage ─────────────────────────────────────────────────────────────────
# Optional storage quota in gigabytes, shown on the Storage dashboard.
# Leave empty or 0 for "no quota" (the default).
STORAGE_QUOTA_GB=0