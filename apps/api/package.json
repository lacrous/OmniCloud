{
  "name": "@omnicloud/api",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "measure:upload-memory": "tsx --expose-gc test/upload-memory.ts",
    "measure:download-memory": "tsx --expose-gc test/download-memory.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "@omnicloud/core": "workspace:*",
    "@omnicloud/database": "workspace:*",
    "@omnicloud/shared": "workspace:*",
    "@omnicloud/telegram": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
